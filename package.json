{
  "name": "@effect-x/ai-commit",
  "version": "0.0.5",
  "description": "AI commit cli with git and jj support.",
  "keywords": [
    "cli",
    "commit",
    "effect",
    "git",
    "jj",
    "jujutsu",
    "llm"
  ],
  "homepage": "https://github.com/effect-anything/ai-commit",
  "bugs": {
    "url": "https://github.com/effect-anything/ai-commit/issues"
  },
  "license": "MIT",
  "contributors": [
    "xesrevinu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-anything/ai-commit.git"
  },
  "bin": {
    "ai-commit": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/bin.js",
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "lefthook install && effect-tsgo patch",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "generate:schemas": "bun run scripts/generate-config-schemas.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepack": "bun run build && bun run generate:schemas"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/ai-openai": "^4.0.0-beta.101",
    "@effect/platform-node": "^4.0.0-beta.101",
    "@effect/tsgo": "^0.24.3",
    "@effect/vitest": "^4.0.0-beta.101",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.101",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=24"
  },
  "inlinedDependencies": {
    "@effect/ai-openai": "4.0.0-beta.101",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "ini": "7.0.0",
    "toml": "4.1.1",
    "yaml": "2.9.0"
  },
  "knip": {
    "ignoreDependencies": [
      "@effect/language-service"
    ]
  }
}
